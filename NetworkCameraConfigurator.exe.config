<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="NetworkCameraConfigurator.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
    </startup>
    <userSettings>
        <NetworkCameraConfigurator.Properties.Settings>
            <setting name="networkDeviceIpAdresse" serializeAs="String">
                <value>192.168.0.75</value>
            </setting>
            <setting name="networkDeviceStreamingPort" serializeAs="String">
                <value>8884</value>
            </setting>
            <setting name="networkDeviceSettingPort" serializeAs="String">
                <value>8885</value>
            </setting>
            <setting name="startLiveStream" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="autoReset" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ShowConsole" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="enableRouting" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="Simplify" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="routingAddress" serializeAs="String">
                <value>192.168.11.101</value>
            </setting>
            <setting name="gStreamerPath" serializeAs="String">
                <value>C:\gstreamer\1.0\x86_64\bin\</value>
            </setting>
            <setting name="aptinaIniPath" serializeAs="String">
                <value>G:\Aptina Imaging\Plugins\</value>
            </setting>
            <setting name="screenShotPath" serializeAs="String">
                <value />
            </setting>
            <setting name="gstPipe" serializeAs="String">
                <value>gst-launch-1.0.exe udpsrc port= $P ! application/x-rtp ! rtpjitterbuffer ! rtph264depay ! h264parse ! openh264dec ! videoscale ! videoconvert ! autovideosink</value>
            </setting>
            <setting name="ShowNotification" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="Setting" serializeAs="String">
                <value>baum</value>
            </setting>
            <setting name="gstPipeMjpeg" serializeAs="String">
                <value>gst-launch-1.0 udpsrc port=$P caps=application/x-rtp ! rtpjitterbuffer latency=10 ! rtpjpegdepay ! jpegparse ! jpegdec ! videoconvert ! fpsdisplaysink sync=false</value>
            </setting>
            <setting name="PreferGstreamer" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="firstStart" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ScreenShotName" serializeAs="String">
                <value>ScreenShot_$time</value>
            </setting>
            <setting name="AutoPlayOnStartup" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="OfferIpsViaDhcp" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="RecentDHCPSererIP" serializeAs="String">
                <value>0</value>
            </setting>
        </NetworkCameraConfigurator.Properties.Settings>
    </userSettings>
</configuration>
